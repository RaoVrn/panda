# Panda AI: Groq API key.
# Copy this file to `.env` and paste your key:
#   VITE_GROQ_API_KEY=gsk_...
#
# Get a key at https://console.groq.com. The key is read at build time from
# import.meta.env.VITE_GROQ_API_KEY.
# Never commit your real `.env`. It is git-ignored.
VITE_GROQ_API_KEY=

# ---- Panda User System (Supabase) ----
# Create a project at https://supabase.com, then copy the Project URL and the
# public anon key from Settings → API. Run `supabase/migrations/0001_init.sql`
# against the project first. When these are empty the app runs in anonymous
# (unconfigured) mode; auth and profile features unlock once they're set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Providers to enable (comma-separated). "groq" is implemented; future
# providers plug in through the AIProvider contract.
VITE_AI_PROVIDER=groq

# Primary Groq model.
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Fallback models, comma-separated. Tried automatically, in order, when the
# primary model fails (429 / 5xx / network / unavailable / 404).
VITE_GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# Hard deadline for a SINGLE provider call, in milliseconds (default 45000).
# A stalled call is aborted and retried/fallen back.
VITE_AI_TIMEOUT=45000

# Retries after the first attempt. Exponential backoff (1s, 2s, 4s) for
# transient errors. Default 2.
VITE_AI_MAX_RETRIES=2

# Overall budget for one request in ms, including intentional retry waits
# (defaults to timeout * (maxRetries + 1) * 2).
VITE_AI_MAX_TOTAL_MS=

# How long identical answers are cached in the session, in ms (default 60000).
VITE_AI_CACHE_TTL=60000
